<Window x:Class="Carp.Gui.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carp"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PageBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Foreground="{StaticResource Ink}">
    <Border Padding="20,16">
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" FontSize="11.5" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18" />

            <Border x:Name="DetailsBorder" Background="#FBF6EC" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,10,0,0"
                    Visibility="Collapsed">
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailsBox" FontFamily="Consolas, Microsoft YaHei UI" FontSize="10.5"
                               Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}"
                        Width="96" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}"
                        Width="112" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
