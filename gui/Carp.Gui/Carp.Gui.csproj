<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 备份目录选择使用 System.Windows.Forms.FolderBrowserDialog（WPF 没有等价控件）。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Carp</AssemblyName>
    <RootNamespace>Carp.Gui</RootNamespace>
    <Product>Carp</Product>
    <AssemblyTitle>Carp 控制面板</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 版本号由 scripts/build-gui.sh 通过 -p:Version/-p:InformationalVersion 注入，
         且必须与 Go 核的 version.Version 完全一致（不一致 GUI 会进只读模式）。 -->
    <Version>0.0.0</Version>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- exe / 窗口 / 托盘共用一套图标（由 web/public/favicon.svg 转出的多尺寸 .ico）。 -->
    <ApplicationIcon>Assets\Carp-running.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Carp-running.ico" />
    <Resource Include="Assets\Carp-idle.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms 只为 FolderBrowserDialog 引入；去掉它的全局 using，避免
         Application / Button / Point 等与 WPF 类型冲突。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 构建脚本把 Windows 版核心释放在 payload/carp-core.exe；单文件包内嵌。 -->
    <EmbeddedResource Include="payload\carp-core.exe" Condition="Exists('payload\carp-core.exe')">
      <LogicalName>Carp.Gui.payload.carp-core.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
