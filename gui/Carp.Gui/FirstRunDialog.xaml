<Window x:Class="Carp.Gui.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号与密码"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Padding="24" Background="{StaticResource PageBg}">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="管理员账号已就绪" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink}" />
            <TextBlock x:Name="MessageText"
                       Text="用户名 admin。下面是一次性初始密码，登录成功后请立即在网盘「设置」里修改。"
                       FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16" />

            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="AccountLabel" Text="用户名" FontSize="11.5" Foreground="{StaticResource Muted}" />
                    <TextBlock x:Name="AccountText" Text="admin" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" Margin="0,2,0,12" />

                    <TextBlock Text="密码" FontSize="11.5" Foreground="{StaticResource Muted}" />
                    <TextBox x:Name="PasswordBox" IsReadOnly="True" Margin="0,4,0,0"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="14" Padding="8,6"
                             Background="#FAF8F3" BorderBrush="{StaticResource CardBorder}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="HintText" FontSize="12" Foreground="{StaticResource Amber}"
                       TextWrapping="Wrap" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="关闭" Width="96" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Click="Close_Click" />
                <Button Content="复制密码" Width="112" Style="{StaticResource PrimaryButton}" Click="Copy_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
