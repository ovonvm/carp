<Window x:Class="Carp.Gui.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首次启动"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F7F4EE"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Padding="24" Background="#F7F4EE">
        <StackPanel>
            <TextBlock Text="管理员账号已就绪" FontSize="18" FontWeight="SemiBold" Foreground="#241F1A" />
            <TextBlock Text="用户名 admin。下面是一次性初始密码，登录成功后请立即在网盘「设置」里修改。"
                       FontSize="12.5" Foreground="#8A8074" TextWrapping="Wrap" Margin="0,6,0,16" />

            <Border Background="#FFFFFF" BorderBrush="#E6E1D8" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="用户名" FontSize="11.5" Foreground="#8A8074" />
                    <TextBlock Text="admin" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,12" />

                    <TextBlock Text="初始密码" FontSize="11.5" Foreground="#8A8074" />
                    <TextBox x:Name="PasswordBox" IsReadOnly="True" Margin="0,4,0,0"
                             FontFamily="Consolas, 微软雅黑" FontSize="14" Padding="8,6"
                             Background="#FAF8F3" BorderBrush="#E6E1D8" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="HintText" FontSize="12" Foreground="#B45309" TextWrapping="Wrap" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="关闭" Width="96" Height="38" Margin="0,0,10,0" Click="Close_Click" />
                <Button Content="复制密码" Width="112" Height="38" Background="#E8731F" Foreground="#FFFFFF"
                        BorderThickness="0" Click="Copy_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
