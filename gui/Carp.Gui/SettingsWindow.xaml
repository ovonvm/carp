<Window x:Class="Carp.Gui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBg}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border BorderBrush="#E4D5BE" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource RailBg}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="设置"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource ChromeCloseButton}"
                            HorizontalAlignment="Right"
                            Margin="0,0,8,0"
                            Content="&#xE711;"
                            Click="Cancel_Click"
                            ToolTip="关闭" />
                </Grid>
            </Border>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Margin="18,14,18,10">
                    <TextBlock Text="服务" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Width="110">
                            <TextBlock Text="端口" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <TextBox x:Name="PortBox" Height="26" MaxLength="5" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="profile" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <ComboBox x:Name="ProfileBox" Height="26">
                                <ComboBoxItem Content="low（低占用）" />
                                <ComboBoxItem Content="high（高性能）" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Width="120">
                            <TextBlock Text="日志级别" Style="{StaticResource Label}" Margin="0,0,0,4" />
                            <ComboBox x:Name="LogLevelBox" Height="26">
                                <ComboBoxItem Content="debug" />
                                <ComboBoxItem Content="info" />
                                <ComboBoxItem Content="warn" />
                                <ComboBoxItem Content="error" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="CookieSecureCheck"
                              Content="Cookie 标记为 Secure（cookie-secure）"
                              Margin="0,0,0,8" />

                    <CheckBox x:Name="AutoStartCheck"
                              Content="开机自启（登录 Windows 后自动启动控制面板）"
                              Margin="0,0,0,14" />

                    <TextBlock Text="存储" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                    <TextBlock Text="数据目录（默认是程序所在目录，只读）" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DataDirBox" Grid.Column="0" Height="26" IsReadOnly="True" />
                        <Button Grid.Column="2"
                                Content="打开"
                                Style="{StaticResource SecondaryButton}"
                                Height="26"
                                Padding="12,0"
                                Click="OpenDataDir_Click" />
                    </Grid>

                    <TextBlock Text="核心程序" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <TextBox x:Name="CorePathBox" Height="26" IsReadOnly="True" Margin="0,0,0,10" />

                    <TextBlock Text="修改端口、profile、日志级别或 cookie-secure 后需要重启核心才能生效。"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            Width="74"
                            Height="30"
                            IsCancel="True"
                            Click="Cancel_Click"
                            Margin="0,0,8,0" />
                    <Button Content="保存"
                            Style="{StaticResource PrimaryButton}"
                            Width="74"
                            Height="30"
                            IsDefault="True"
                            Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
