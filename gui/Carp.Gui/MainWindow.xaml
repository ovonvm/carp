<Window x:Class="Carp.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carp 控制面板"
        Width="760" Height="470"
        MinWidth="760" MinHeight="470" MaxWidth="760" MaxHeight="470"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border BorderBrush="#E4D5BE" BorderThickness="1" Background="{StaticResource PageBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==================== 标题栏（无边框，可拖动） ==================== -->
            <Grid Grid.Row="0" Background="{StaticResource PageBg}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="16" Height="16" CornerRadius="5" Background="{StaticResource Accent}" />
                    <TextBlock Text="Carp 控制面板" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="最小化"
                            Click="Minimize_Click" />
                    <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" ToolTip="关闭"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{StaticResource Line}" />

            <!-- ==================== 主体：图标栏 + 内容 ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource RailBg}" BorderBrush="{StaticResource Line}"
                        BorderThickness="0,0,1,0">
                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <RadioButton x:Name="RailHome" Style="{StaticResource NavButton}" IsChecked="True"
                                     ToolTip="概览" Click="RailHome_Click">
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE80F;" />
                        </RadioButton>
                        <Button Style="{StaticResource RailButton}" ToolTip="设置" Click="Settings_Click">
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE713;" />
                        </Button>
                        <Button Style="{StaticResource RailButton}" ToolTip="打开数据目录" Click="OpenDataDir_Click">
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xED25;" />
                        </Button>
                        <Button Style="{StaticResource RailButton}" ToolTip="打开日志文件" Click="OpenLogFile_Click">
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE8FD;" />
                        </Button>
                        <Button Style="{StaticResource RailButton}" ToolTip="关于" Click="About_Click">
                            <TextBlock Style="{StaticResource RailIcon}" Text="&#xE946;" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="14,10,14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="90" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="124" />
                        </Grid.RowDefinitions>

                        <!-- 页头 -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="服务概览" Style="{StaticResource H1}" />
                                <TextBlock x:Name="HeaderMeta" Style="{StaticResource Caption}"
                                           VerticalAlignment="Bottom" Margin="10,0,0,2" />
                            </StackPanel>
                            <Border x:Name="ReadOnlyBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{StaticResource AmberSoft}" CornerRadius="6" Padding="7,2"
                                    Visibility="Collapsed">
                                <TextBlock Text="只读模式" FontSize="9.5" Foreground="{StaticResource Amber}" />
                            </Border>
                        </Grid>

                        <!-- 状态卡（Aurora 渐变在运行中缓慢流动） -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True" Padding="0">
                            <Grid>
                                <Border x:Name="AuroraLayer" CornerRadius="10" ClipToBounds="True"
                                        Visibility="Collapsed" IsHitTestVisible="False">
                                    <Grid>
                                        <Rectangle x:Name="AuroraRect" Width="640" Height="140"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   Opacity="0.55" IsHitTestVisible="False">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#007C6CFF" Offset="0" />
                                                    <GradientStop Color="#557C6CFF" Offset="0.28" />
                                                    <GradientStop Color="#66A88BFF" Offset="0.5" />
                                                    <GradientStop Color="#557C6CFF" Offset="0.72" />
                                                    <GradientStop Color="#007C6CFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.RenderTransform>
                                                <TranslateTransform x:Name="AuroraShift" X="-280" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Grid>
                                </Border>

                                <Grid Margin="16,0,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="StatusIconHost" Width="44" Height="44" CornerRadius="22"
                                            Background="{StaticResource GreenSoft}" VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusIcon" Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   Foreground="{StaticResource Green}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusTitle" Text="服务已停止" FontSize="15"
                                                   FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="StatusSub" Style="{StaticResource Caption}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="OpenBrowserButton" Width="108" Height="32"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="OpenBrowser_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="打开网盘" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="StopButton" Width="72" Height="32" Content="停止"
                                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                                Click="StartStop_Click" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 快捷操作 / 数据与备份 -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,9">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="7" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="快捷操作" Style="{StaticResource SectionTitle}" />
                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="7" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="TileStartStop" Grid.Row="0" Grid.Column="0"
                                                Style="{StaticResource TileButton}" Click="StartStop_Click">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="启动 / 停止" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="本机后台进程" Style="{StaticResource Label}"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="TileDataDir" Grid.Row="0" Grid.Column="2"
                                                Style="{StaticResource TileButton}" Click="OpenDataDir_Click">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="打开数据目录" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="文件管理器" Style="{StaticResource Label}"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="TileDoctor" Grid.Row="2" Grid.Column="0"
                                                Style="{StaticResource TileButton}" Click="Doctor_Click">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="运行自检" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="doctor" Style="{StaticResource Label}"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="TileResetPassword" Grid.Row="2" Grid.Column="2"
                                                Style="{StaticResource TileButton}" Click="ResetPassword_Click">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="重置 root 密码" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="需确认" Style="{StaticResource Label}"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,9">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                                            Padding="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="上次备份" Style="{StaticResource Label}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="BackupTimeText" Text="暂无备份"
                                                       Style="{StaticResource Caption}"
                                                       Foreground="{StaticResource Ink}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <TextBlock Text="备份位置" Style="{StaticResource Label}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="BackupPathText" Text="—"
                                                   Style="{StaticResource Caption}"
                                                   Foreground="{StaticResource Ink}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   MaxWidth="190" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </Grid>

                                    <Button x:Name="BackupButton" Grid.Row="3" Height="34"
                                            Style="{StaticResource PrimaryButton}" Click="Backup_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="立即备份" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 运行日志 -->
                        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="LogCountText" Style="{StaticResource Label}"
                                                   Text="最近 100 行" VerticalAlignment="Center" />
                                        <Button x:Name="ClearLogButton" Content="清空" Height="20" FontSize="10"
                                                Padding="6,0" Margin="6,0,0,0"
                                                Style="{StaticResource GhostButton}" Click="ClearLog_Click" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="{StaticResource LogBg}" CornerRadius="8"
                                        Padding="10,6" Margin="0,6,0,0">
                                    <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
