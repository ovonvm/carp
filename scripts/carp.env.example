# Carp runtime configuration. Installed to /opt/carp/carp.env (mode 0600).
#
# systemd reads this file through EnvironmentFile; `carp config` edits it and
# `carp config --show` prints it. After a change: sudo carp service restart.

# The service listens on loopback only; expose it through nginx/Caddy.
CARP_ADDR=127.0.0.1:50011

# Data directory: database, blobs, bootstrap secrets.
CARP_DATA_DIR=/opt/carp/data

# Memory profile: low (512 MB baseline) or high (4 GB+ hosts).
CARP_PROFILE=low

# Secure cookie flag: auto (behind HTTPS reverse proxy) | always | never.
CARP_COOKIE_SECURE=auto

# Optional: expose the Go pprof endpoint on loopback for profiling.
#CARP_PPROF=127.0.0.1:6060

# Optional: external worker instead of the one embedded in `serve`.
#CARP_WORKER=external

# Optional: qBittorrent WebUI for magnet/torrent offline downloads.
#CARP_QB_URL=http://127.0.0.1:8080
#CARP_QB_USERNAME=admin
#CARP_QB_PASSWORD=change-me
